@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <!-- Welcome Header -->
    <div class="jumbotron bg-primary text-white p-5 rounded shadow-sm mb-4">
        <h1 class="display-4">
            <i class="bi bi-hospital-fill me-3"></i>HCA Mini EHR
        </h1>
        <p class="lead">Healthcare Management System - Capstone Project</p>
        <hr class="my-4 bg-white" />
        <p>Manage patients, appointments, and lab orders efficiently with comprehensive reporting.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Total Patients</h6>
                            <h2 class="mb-0">@Model.TotalPatients</h2>
                        </div>
                        <div>
                            <i class="bi bi-people-fill" style="font-size: 3rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-primary bg-opacity-75">
                    <a asp-page="/Patients/Index" class="text-white text-decoration-none">
                        View All <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Upcoming</h6>
                            <h2 class="mb-0">@Model.UpcomingAppointments</h2>
                        </div>
                        <div>
                            <i class="bi bi-calendar-check-fill" style="font-size: 3rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-success bg-opacity-75">
                    <a asp-page="/Appointments/Index" class="text-white text-decoration-none">
                        View All <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Pending Labs</h6>
                            <h2 class="mb-0">@Model.PendingLabOrders</h2>
                        </div>
                        <div>
                            <i class="bi bi-clipboard-pulse-fill" style="font-size: 3rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-warning bg-opacity-75">
                    <a asp-page="/LabOrders/Index" class="text-white text-decoration-none">
                        View All <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-uppercase mb-0">Total Appts</h6>
                            <h2 class="mb-0">@Model.TotalAppointments</h2>
                        </div>
                        <div>
                            <i class="bi bi-graph-up-arrow" style="font-size: 3rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-info bg-opacity-75">
                    <a asp-page="/Reports/Index" class="text-white text-decoration-none">
                        View Reports <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-plus-fill text-primary" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Patient Management</h5>
                    <p class="card-text">Add, edit, and manage patient records with comprehensive details.</p>
                    <a asp-page="/Patients/Index" class="btn btn-primary">Manage Patients</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-plus-fill text-success" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Appointment Scheduling</h5>
                    <p class="card-text">Schedule and track appointments with integrated lab order management.</p>
                    <a asp-page="/Appointments/Index" class="btn btn-success">View Appointments</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up text-info" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Healthcare Reports</h5>
                    <p class="card-text">View comprehensive LINQ-powered reports and analytics.</p>
                    <a asp-page="/Reports/Index" class="btn btn-info">View Reports</a>
                </div>
            </div>
        </div>
    </div>


</div>
