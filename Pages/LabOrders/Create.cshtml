@page
@model HCAMiniEHR.Pages.LabOrders.CreateModel
@{
    ViewData["Title"] = "Create Lab Order";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-clipboard-plus-fill me-2"></i>Create Lab Order
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="AppointmentId" class="form-label">Appointment</label>
                            <select asp-for="AppointmentId" asp-items="Model.Appointments" class="form-select" required>
                                <option value="0">-- Select Appointment --</option>
                            </select>
                            <span asp-validation-for="AppointmentId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TestName" class="form-label">Test Name</label>
                            <select asp-for="TestName" asp-items="Model.TestTypes" class="form-select" required>
                                <option value="">-- Select Test Type --</option>
                            </select>
                            <span asp-validation-for="TestName" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <small>The lab order will be created with "Pending" status by default. 
                            You can update the status and add results later.</small>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save me-1"></i>Create Lab Order
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
